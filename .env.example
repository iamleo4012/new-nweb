# Copy this file to .env and fill in real values.
# Never commit .env — it is git-ignored.

# PostgreSQL connection string.
# Format: postgresql://<role>:<password>@<host>:<port>/<database>
# Sprint 0 (SEC-02) recommends a dedicated least-privilege role + database
# (e.g. postgresql://nassim_app:<password>@localhost:5432/nassim).
DATABASE_URL="postgresql://nassim_app:CHANGE_ME@localhost:5432/nassim"

# Secret used to sign session JWTs (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 bytes (64 hex chars). Rotate on any suspected leak.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_HEX_STRING"

# Name of the httpOnly cookie that carries the session JWT.
SESSION_COOKIE_NAME="nassim_sid"

# Seeded administrator account. The seed script (prisma/seed.mjs) creates
# this user on first run with role ADMIN. The password is hashed with bcrypt
# (cost 10) and stored in the User table; it is never re-hashed on re-seed
# if the user already exists.
ADMIN_SEED_EMAIL="admin@alnassim.com"
ADMIN_SEED_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"

# Email (Resend) — for password reset emails
# Get your API key from https://resend.com/onboarding
RESEND_API_KEY="re_YOUR_API_KEY"
APP_URL="http://localhost:3000"
EMAIL_FROM="AL-NASSIM <onboarding@resend.dev>"
