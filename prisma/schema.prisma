generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PurchaseMode {
  ONLINE
  INQUIRY
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKING
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
}

model Department {
  id           Int          @id @default(autoincrement())
  slug         String       @unique
  name         String
  purchaseMode PurchaseMode @default(ONLINE)
  categories   Category[]
}

model Category {
  id           Int        @id @default(autoincrement())
  slug         String     @unique
  name         String
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  products     Product[]
}

model Product {
  id          Int         @id @default(autoincrement())
  slug        String      @unique
  name        String
  description String      @default("")
  price       Decimal     @db.Decimal(10, 3)
  currency    String      @default("KD")
  image       String      @default("")
  images      String[]    @default([])
  line        String      @default("")
  sku         String      @default("")
  specs       Json        @default("[]")
  stock       Int         @default(100)
  isActive    Boolean     @default(true)
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  wishlist    WishlistItem[]
  cartItems   CartItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  name         String
  phone        String     @default("")
  passwordHash String
  role         UserRole   @default(CUSTOMER)
  isActive     Boolean    @default(true)
  sessions     Session[]
  orders       Order[]
  wishlist     WishlistItem[]
  cartItems    CartItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id            Int         @id @default(autoincrement())
  orderNumber   String      @unique
  userId        Int?
  user          User?       @relation(fields: [userId], references: [id])
  customerName  String
  customerEmail String
  customerPhone String
  address       String
  city          String
  notes         String      @default("")
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @db.Decimal(10, 3)
  shipping      Decimal     @db.Decimal(10, 3) @default(2.5)
  total         Decimal     @db.Decimal(10, 3)
  currency      String      @default("KD")
  items         OrderItem[]
  statusHistory OrderStatusEvent[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([customerEmail])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id])
  slug      String
  name      String
  image     String   @default("")
  price     Decimal  @db.Decimal(10, 3)
  quantity  Int

  @@index([orderId])
}

model OrderStatusEvent {
  id        Int         @id @default(autoincrement())
  orderId   Int
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String      @default("")
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Setting {
  key   String @id
  value String
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  action    String
  entity    String
  entityId  String   @default("")
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([entity])
}
